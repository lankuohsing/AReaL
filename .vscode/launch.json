{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GSM8K GRPO (Volcano 2GPU)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/examples/math/gsm8k_rl.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": true,
      "args": [
        "--config",
        "examples/math/gsm8k_grpo_volcano_2gpu.yaml"
      ],
      "env": {
        "CUDA_VISIBLE_DEVICES": "0,1",
        "AREAL_DEBUG_ROLLOUT": "1",
        "AREAL_DEBUG_ROLLOUT_PORT": "5678",
        "PYTHONPATH": "${workspaceFolder}:${env:PYTHONPATH}",
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "GSM8K GRPO (Volcano 2GPU, debug 1 sample)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/examples/math/gsm8k_rl.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": true,
      "args": [
        "--config",
        "examples/math/gsm8k_grpo_volcano_2gpu.yaml",
        "train_dataset.batch_size=1",
        "gconfig.n_samples=1",
        "+total_train_steps=1"
      ],
      "env": {
        "CUDA_VISIBLE_DEVICES": "0,1",
        "AREAL_DEBUG_ROLLOUT": "1",
        "AREAL_DEBUG_ROLLOUT_PORT": "5678",
        "PYTHONPATH": "${workspaceFolder}:${env:PYTHONPATH}",
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "GSM8K GRPO (Volcano 2GPU, 4 steps)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/examples/math/gsm8k_rl.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": true,
      "args": [
        "--config",
        "examples/math/gsm8k_grpo_volcano_2gpu.yaml",
        "+total_train_steps=4"
      ],
      "env": {
        "CUDA_VISIBLE_DEVICES": "0,1",
        "AREAL_DEBUG_ROLLOUT": "1",
        "AREAL_DEBUG_ROLLOUT_PORT": "5678",
        "PYTHONPATH": "${workspaceFolder}:${env:PYTHONPATH}",
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "Attach Rollout Worker (5678)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "justMyCode": false
    }
  ]
}
